{
  "permissions": {
    "allow": [
      "mcp__Claude_Code_Remote__add_repo",
      "mcp__Claude_Code_Remote__register_repo_root",
      "mcp__Claude_Code_Remote__list_repos",
      "mcp__claude-code-remote__add_repo",
      "mcp__claude-code-remote__register_repo_root",
      "mcp__claude-code-remote__list_repos",
      "Bash(git clone --depth 1 https://github.com/rebibomichael-web/stock-tracker /workspace/stock-tracker)",
      "Bash(git clone --depth 1 https://github.com/rebibomichael-web/trading-src /workspace/trading-src)",
      "Bash(git clone --depth 1 https://github.com/rebibomichael-web/trading-suite /workspace/trading-suite)",
      "Bash(git clone --depth 1 https://github.com/rebibomichael-web/trading-data /workspace/trading-data)",
      "Bash(git fetch origin)",
      "Bash(python3 journal_dashboard/build_journal_data.py --selftest)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
